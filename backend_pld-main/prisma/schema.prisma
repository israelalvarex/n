// =============================================================================
// schema.prisma  ·  generado desde docs/db/presupuesto.dbml
//
// NO editar a mano si el DBML sigue siendo la fuente de verdad: regenerar.
// Todo en ingles: tablas y columnas fisicas en snake_case, la API de Prisma en
// camelCase / PascalCase. app_user y app_role llevan prefijo porque user y
// role son palabras reservadas o riesgosas en PostgreSQL.
//
// Las tablas auth_* las administra Better Auth. Estan aqui para que Prisma
// conozca las relaciones, pero sus migraciones las emite el CLI de Better Auth.
// =============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  // NestJS compila a CommonJS. Sin esto el cliente sale con import.meta.url,
  // que es sintaxis ESM, y Node se niega a cargarlo desde dist/.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Month {
  jan
  feb
  mar
  apr
  may
  jun
  jul
  aug
  sep
  oct
  nov
  dec

  @@map("month")
}

enum LineNature {
  revenue
  expense
  rawMaterialCost
  payroll
  tax
  asset
  depreciation
  indicator

  @@map("line_nature")
}

enum Scenario {
  base
  target
  aggressive

  @@map("scenario")
}

enum BudgetStatus {
  draft
  inReview
  approved
  closed
  reforecast

  @@map("budget_status")
}

enum Frequency {
  monthly
  daily
  perHeadcount
  perEvent
  variable
  yearly
  bimonthly
  quarterly
  biannual
  seasonal

  @@map("frequency")
}

enum ResourceType {
  parameter
  supply
  payScale
  rate

  @@map("resource_type")
}

enum QuantitySource {
  fixed
  derivedFromDau

  @@map("quantity_source")
}

enum LineSource {
  resource
  formula
  parameter
  manual
  previous_year
  forecast

  @@map("line_source")
}

enum RevenueStream {
  slots
  tables
  sportsbook
  fnbThirdParty
  loyaltyClub
  casinoComps
  events
  other

  @@map("revenue_stream")
}

enum LicenseType {
  external
  internal

  @@map("license_type")
}

enum MachineOwnership {
  ownedCdm
  ownedFmx
  leasedFromVendor

  @@map("machine_ownership")
}

enum SupplyBlockType {
  thirdPartySales
  aggressivePromos
  foodComps
  employeeComps

  @@map("supply_block_type")
}

enum SupplyHistoryType {
  packsSold
  cigarettePurchase
  bagInBoxPurchase

  @@map("supply_history_type")
}

enum CardType {
  debit
  credit
  average

  @@map("card_type")
}

enum TaxLine {
  slots
  sportsbook
  tables
  fnb

  @@map("tax_line")
}

enum ThreadStatus {
  open
  resolved

  @@map("thread_status")
}

enum AttachmentStatus {
  pending
  available
  deleted

  @@map("attachment_status")
}

enum CaptureStatus {
  notStarted
  inProgress
  complete
  submitted
  approved
  rejected

  @@map("capture_status")
}

enum ReviewOutcome {
  approvedAndFrozen
  changesRequested
  rejected

  @@map("review_outcome")
}

enum ScopeMode {
  all
  selected

  @@map("scope_mode")
}

enum AccessResult {
  allowed
  deniedDepartment
  deniedBusinessUnit
  deniedPermission

  @@map("access_result")
}

enum Action {
  read
  create
  update
  delete
  capture
  approve
  reopen
  export
  manage

  @@map("action")
}

enum SystemObjectType {
  table
  view
  report
  module
  operation

  @@map("system_object_type")
}

enum PermissionEffect {
  allow
  deny

  @@map("permission_effect")
}

enum SettingScope {
  global
  fiscalYear
  businessUnit
  department
  costCenter
  user

  @@map("setting_scope")
}

enum MetricUnit {
  count
  currency
  percentage
  ratio
  duration

  @@map("metric_unit")
}

enum MetricGranularity {
  daily
  weekly
  monthly
  quarterly
  yearly

  @@map("metric_granularity")
}

enum MetricDefinitionType {
  budgeted
  forecasted
  manual

  @@map("metric_definition_type")
}

model Company {
  id           Int            @id @default(autoincrement())
  code         String         @unique @db.VarChar(20)
  legalName    String         @map("legal_name") @db.VarChar(255)
  taxId        String?        @map("tax_id") @db.VarChar(13)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  businessUnit BusinessUnit[]

  @@map("company")
}

model BusinessUnit {
  id                         Int                          @id @default(autoincrement())
  companyId                  Int                          @map("company_id")
  code                       String                       @unique @db.VarChar(20)
  name                       String                       @db.VarChar(150)
  type                       String                       @db.VarChar(30)
  city                       String?                      @db.VarChar(100)
  active                     Boolean                      @default(true)
  company                    Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  costCenter                 CostCenter[]
  metricForecast             MetricForecast[]
  metricTraining             MetricTraining[]
  metricResource             MetricResource[]
  metricResourceValue        MetricResourceValue[]
  budget                     Budget[]
  businessUnitMonthlyHistory BusinessUnitMonthlyHistory[]
  supplyHistory              SupplyHistory[]
  resourceQuantity           ResourceQuantity[]
  monthlyDemand              MonthlyDemand[]
  resourceFactor             ResourceFactor[]
  commentThread              CommentThread[]
  setting                    Setting[]
  accessGrantBusinessUnit    AccessGrantBusinessUnit[]
  userContext                UserContext[]
  accessLog                  AccessLog[]
  metricBudgetMonth          MetricBudgetMonth[]

  @@map("business_unit")
}

model CostCenter {
  id                    Int                     @id @default(autoincrement())
  businessUnitId        Int                     @map("business_unit_id")
  code                  String                  @db.VarChar(20)
  name                  String                  @db.VarChar(150)
  active                Boolean                 @default(true)
  businessUnit          BusinessUnit            @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  budget                Budget[]
  setting               Setting[]
  accessGrantCostCenter AccessGrantCostCenter[]
  userContext           UserContext[]

  @@unique([businessUnitId, code])
  @@map("cost_center")
}

model User {
  id                             Int                      @id @default(autoincrement())
  authUserId                     String?                  @unique @map("auth_user_id") @db.VarChar(64)
  departmentId                   Int?                     @map("department_id")
  name                           String                   @db.VarChar(150)
  jobTitle                       String?                  @map("job_title") @db.VarChar(150)
  email                          String                   @unique @db.VarChar(180)
  isSuperadmin                   Boolean                  @default(false) @map("is_superadmin")
  active                         Boolean                  @default(true)
  lastLogin                      DateTime?                @map("last_login") @db.Timestamptz(6)
  createdAt                      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  department                     Department?              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  authUser                       AuthUser?                @relation(fields: [authUserId], references: [id], onDelete: Restrict)
  category                       Category[]
  budget                         Budget[]
  metricResource                 MetricResource[]
  metricResourceValue            MetricResourceValue[]
  metricResourceSnapshot         MetricResourceSnapshot[]
  resourceValue                  ResourceValue[]
  resourceRecalculation          ResourceRecalculation[]
  budgetLineAssignmentUser       BudgetLineAssignment[]   @relation("partida_asignacion_usuario_id")
  budgetLineAssignmentAssignedBy BudgetLineAssignment[]   @relation("partida_asignacion_asignado_por")
  commentThreadOpenedBy          CommentThread[]          @relation("conversacion_abierta_por")
  commentThreadResolvedBy        CommentThread[]          @relation("conversacion_resuelta_por")
  message                        Message[]
  attachment                     Attachment[]
  reviewSubmission               ReviewSubmission[]
  reviewDecision                 ReviewDecision[]
  fiscalYear                     FiscalYear[]
  budgetAuditLog                 BudgetAuditLog[]
  setting                        Setting[]
  accessGrantUser                AccessGrant[]            @relation("asignacion_usuario_id")
  accessGrantGrantedBy           AccessGrant[]            @relation("asignacion_otorgado_por")
  userContext                    UserContext[]
  accessLog                      AccessLog[]

  @@map("app_user")
}

model Department {
  id                    Int                     @id @default(autoincrement())
  code                  String                  @unique @db.VarChar(40)
  name                  String                  @db.VarChar(150)
  active                Boolean                 @default(true)
  user                  User[]
  budgetSheet           BudgetSheet[]
  category              Category[]
  budgetLine            BudgetLine[]
  resource              Resource[]
  commentThread         CommentThread[]
  reviewSubmission      ReviewSubmission[]
  budgetSheetReview     BudgetSheetReview[]
  systemObject          SystemObject[]
  setting               Setting[]
  accessGrantDepartment AccessGrantDepartment[]
  accessLog             AccessLog[]
  metricForecast        MetricForecast[]
  metricTraining        MetricTraining[]
  metricResourceValue   MetricResourceValue[]

  @@map("department")
}

model FiscalYear {
  id                    Int                     @id @default(autoincrement())
  year                  Int                     @unique
  referenceYear         Int                     @map("reference_year")
  isOpen                Boolean                 @default(true) @map("is_open")
  openedOn              DateTime?               @map("opened_on") @db.Date
  closesOn              DateTime?               @map("closes_on") @db.Date
  closedAt              DateTime?               @map("closed_at") @db.Timestamptz(6)
  closedBy              Int?                    @map("closed_by")
  closedBy2             User?                   @relation(fields: [closedBy], references: [id], onDelete: Restrict)
  monthCalendar         MonthCalendar[]
  budget                Budget[]
  metricResourceValue   MetricResourceValue[]
  posRate               PosRate[]
  resourceQuantity      ResourceQuantity[]
  monthlyDemand         MonthlyDemand[]
  resourceFactor        ResourceFactor[]
  resourceRecalculation ResourceRecalculation[]
  commentThread         CommentThread[]
  reviewSubmission      ReviewSubmission[]
  setting               Setting[]
  accessGrant           AccessGrant[]
  userContext           UserContext[]
  metricBudgetMonth     MetricBudgetMonth[]

  @@map("fiscal_year")
}

model MonthCalendar {
  id           Int        @id @default(autoincrement())
  fiscalYearId Int        @map("fiscal_year_id")
  month        Month
  monthNumber  Int        @map("month_number") @db.SmallInt
  days         Int        @db.SmallInt
  holidays     Int        @default(0) @db.SmallInt
  paymentDays  Int?       @map("payment_days") @db.SmallInt
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  @@unique([fiscalYearId, month])
  @@map("month_calendar")
}

model BudgetSheet {
  id                  Int               @id @default(autoincrement())
  departmentId        Int?              @map("department_id")
  code                String            @unique @db.VarChar(40)
  name                String            @db.VarChar(150)
  nature              LineNature
  sortOrder           Int               @map("sort_order") @db.SmallInt
  appliesToCasino     Boolean           @default(true) @map("applies_to_casino")
  appliesToRestaurant Boolean           @default(true) @map("applies_to_restaurant")
  department          Department?       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  budgetSheetNote     BudgetSheetNote[]
  category            Category[]

  @@map("budget_sheet")
}

model BudgetSheetNote {
  id            Int         @id @default(autoincrement())
  budgetSheetId Int         @map("budget_sheet_id")
  type          String      @db.VarChar(20)
  sortOrder     Int         @map("sort_order") @db.SmallInt
  text          String
  budgetSheet   BudgetSheet @relation(fields: [budgetSheetId], references: [id], onDelete: Restrict)

  @@map("budget_sheet_note")
}

model Category {
  id               Int          @id @default(autoincrement())
  budgetSheetId    Int          @map("budget_sheet_id")
  parentCategoryId Int?         @map("parent_category_id")
  departmentId     Int?         @map("department_id")
  ownerUserId      Int?         @map("owner_user_id")
  code             String       @db.VarChar(60)
  name             String       @db.VarChar(180)
  sortOrder        Int          @map("sort_order") @db.SmallInt
  isSubtotal       Boolean      @default(false) @map("is_subtotal")
  budgetSheet      BudgetSheet  @relation(fields: [budgetSheetId], references: [id], onDelete: Restrict)
  parentCategory   Category?    @relation("categoria_categoria_padre_id", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  department       Department?  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  ownerUser        User?        @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  category         Category[]   @relation("categoria_categoria_padre_id")
  lineItem         LineItem[]
  fixedAsset       FixedAsset[]

  @@unique([budgetSheetId, code])
  @@map("category")
}

model LineItem {
  id                 Int          @id @default(autoincrement())
  categoryId         Int          @map("category_id")
  code               String       @db.VarChar(80)
  name               String       @db.VarChar(255)
  nature             LineNature
  frequency          Frequency    @default(monthly)
  applicableMonths   Int[]        @map("applicable_months") @db.SmallInt
  glAccount          String?      @map("gl_account") @db.VarChar(30)
  fnbOnly            Boolean      @default(false) @map("fnb_only")
  costCenterOnly     String?      @map("cost_center_only") @db.VarChar(20)
  editable           Boolean      @default(true)
  sortOrder          Int          @map("sort_order") @db.SmallInt
  active             Boolean      @default(true)
  // A que cuenta/subcuenta de metric_forecast/metric_training corresponde
  // este concepto -- curado a mano desde la plataforma, NO se deriva de
  // ningun Excel. department se toma del BudgetLine al consultar, no aqui.
  forecastAccount    String?      @map("forecast_account") @db.VarChar(80)
  forecastSubaccount String?      @map("forecast_subaccount") @db.VarChar(80)
  category           Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  budgetLine         BudgetLine[]
  teamEvent          TeamEvent[]

  @@unique([categoryId, code])
  @@map("line_item")
}

model GlAccount {
  id         Int          @id @default(autoincrement())
  code       String       @unique @db.VarChar(20)
  name       String       @db.VarChar(180)
  active     Boolean      @default(true)
  budgetLine BudgetLine[]
  resource   Resource[]

  @@map("gl_account")
}

model Resource {
  id                    Int                     @id @default(autoincrement())
  departmentId          Int                     @map("department_id")
  glAccountId           Int?                    @map("gl_account_id")
  type                  ResourceType
  code                  String                  @unique @db.VarChar(60)
  name                  String                  @db.VarChar(180)
  unit                  String?                 @db.VarChar(20)
  description           String?                 @db.VarChar(255)
  active                Boolean                 @default(true)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  department            Department              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  glAccount             GlAccount?              @relation(fields: [glAccountId], references: [id], onDelete: Restrict)
  budgetLine            BudgetLine[]
  resourceValue         ResourceValue[]
  resourceQuantity      ResourceQuantity[]
  resourceFactor        ResourceFactor[]
  resourceRecalculation ResourceRecalculation[]

  @@map("resource")
}

model ResourceValue {
  id           Int       @id @default(autoincrement())
  resourceId   Int       @map("resource_id")
  year         Int
  component    String    @default("valor") @db.VarChar(60)
  value        Decimal   @db.Decimal(18, 6)
  isProjection Boolean   @default(false) @map("is_projection")
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(6)
  confirmedBy  Int?      @map("confirmed_by")
  resource     Resource  @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  confirmedBy2 User?     @relation(fields: [confirmedBy], references: [id], onDelete: Restrict)

  @@unique([resourceId, year, component])
  @@map("resource_value")
}

model ResourceQuantity {
  id             Int            @id @default(autoincrement())
  resourceId     Int            @map("resource_id")
  businessUnitId Int            @map("business_unit_id")
  fiscalYearId   Int            @map("fiscal_year_id")
  quantitySource QuantitySource @default(fixed) @map("quantity_source")
  quantity       Decimal?       @db.Decimal(18, 6)
  base           String         @default("dia") @db.VarChar(20)
  resource       Resource       @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  businessUnit   BusinessUnit   @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  fiscalYear     FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  @@unique([resourceId, businessUnitId, fiscalYearId])
  @@map("resource_quantity")
}

model MonthlyDemand {
  id             Int          @id @default(autoincrement())
  businessUnitId Int          @map("business_unit_id")
  fiscalYearId   Int          @map("fiscal_year_id")
  month          Month
  dau            Decimal      @db.Decimal(14, 4)
  guestsServed   Decimal?     @map("guests_served") @db.Decimal(14, 4)
  isEstimated    Boolean      @default(false) @map("is_estimated")
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  fiscalYear     FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  @@unique([businessUnitId, fiscalYearId, month])
  @@map("monthly_demand")
}

model ResourceFactor {
  id             Int           @id @default(autoincrement())
  resourceId     Int           @map("resource_id")
  businessUnitId Int?          @map("business_unit_id")
  fiscalYearId   Int           @map("fiscal_year_id")
  code           String        @db.VarChar(60)
  value          Decimal       @db.Decimal(18, 6)
  unit           String?       @db.VarChar(20)
  source         String?       @db.VarChar(120)
  resource       Resource      @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  fiscalYear     FiscalYear    @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  @@unique([resourceId, businessUnitId, fiscalYearId, code])
  @@map("resource_factor")
}

model ResourceRecalculation {
  id            BigInt     @id @default(autoincrement())
  resourceId    Int        @map("resource_id")
  fiscalYearId  Int        @map("fiscal_year_id")
  triggeredBy   Int?       @map("triggered_by")
  reason        String     @db.VarChar(60)
  affectedLines Int        @default(0) @map("affected_lines")
  notifiedCount Int        @default(0) @map("notified_count")
  executedAt    DateTime   @default(now()) @map("executed_at") @db.Timestamptz(6)
  resource      Resource   @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  fiscalYear    FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  triggeredBy2  User?      @relation(fields: [triggeredBy], references: [id], onDelete: Restrict)

  @@map("resource_recalculation")
}

model Budget {
  id                        Int                         @id @default(autoincrement())
  fiscalYearId              Int                         @map("fiscal_year_id")
  businessUnitId            Int                         @map("business_unit_id")
  costCenterId              Int                         @map("cost_center_id")
  scenario                  Scenario                    @default(base)
  version                   Int                         @default(1) @db.SmallInt
  status                    BudgetStatus                @default(draft)
  isCurrent                 Boolean                     @default(true) @map("is_current")
  approvedBy                Int?                        @map("approved_by")
  approvedAt                DateTime?                   @map("approved_at") @db.Timestamptz(6)
  createdAt                 DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  fiscalYear                FiscalYear                  @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  businessUnit              BusinessUnit                @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  costCenter                CostCenter                  @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  approvedBy2               User?                       @relation(fields: [approvedBy], references: [id], onDelete: Restrict)
  budgetLine                BudgetLine[]
  monthlyRevenue            MonthlyRevenue[]
  payrollBenefit            PayrollBenefit[]
  teamEvent                 TeamEvent[]
  budgetedTrip              BudgetedTrip[]
  licenseLine               LicenseLine[]
  machineRoyalty            MachineRoyalty[]
  tableRoyalty              TableRoyalty?
  rawMaterialBlock          RawMaterialBlock[]
  rawMaterialMonthlySummary RawMaterialMonthlySummary[]
  posFeeLine                PosFeeLine[]
  fixedAsset                FixedAsset[]
  monthlyDepreciation       MonthlyDepreciation[]
  monthlyTaxBase            MonthlyTaxBase[]
  monthlyTax                MonthlyTax[]
  monthlyProfitShare        MonthlyProfitShare[]
  captureProgress           CaptureProgress?
  reviewDecision            ReviewDecision[]
  budgetSheetReview         BudgetSheetReview[]
  budgetAuditLog            BudgetAuditLog[]
  metricResourceSnapshot    MetricResourceSnapshot[]

  @@unique([fiscalYearId, businessUnitId, costCenterId, scenario, version], map: "ux_budget_version")
  @@index([fiscalYearId, isCurrent])
  @@map("budget")
}

model BudgetLine {
  id                       Int                    @id @default(autoincrement())
  budgetId                 Int                    @map("budget_id")
  lineItemId               Int                    @map("line_item_id")
  departmentId             Int                    @map("department_id")
  glAccountId              Int?                   @map("gl_account_id")
  source                   LineSource             @default(resource)
  resourceId               Int?                   @map("resource_id")
  component                String?                @db.VarChar(60)
  quantity                 Decimal?               @db.Decimal(18, 6)
  quantityUnit             String?                @map("quantity_unit") @db.VarChar(30)
  calculationNote          String?                @map("calculation_note") @db.VarChar(255)
  frequency                Frequency?
  referenceAmount          Decimal?               @map("reference_amount") @db.Decimal(18, 4)
  factor                   Decimal?               @db.Decimal(9, 6)
  factorText               String?                @map("factor_text") @db.VarChar(40)
  totalAnnual              Decimal                @default(0) @map("total_annual") @db.Decimal(18, 4)
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  budget                   Budget                 @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  lineItem                 LineItem               @relation(fields: [lineItemId], references: [id], onDelete: Restrict)
  resource                 Resource?              @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  glAccount                GlAccount?             @relation(fields: [glAccountId], references: [id], onDelete: Restrict)
  department               Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  budgetLineMonth          BudgetLineMonth[]
  budgetLineLinkTargetLine BudgetLineLink[]       @relation("partida_enlace_partida_destino_id")
  budgetLineLinkSourceLine BudgetLineLink[]       @relation("partida_enlace_partida_origen_id")
  budgetLineAssignment     BudgetLineAssignment[]
  monthlyActual            MonthlyActual[]

  @@unique([budgetId, lineItemId])
  @@index([resourceId])
  @@map("budget_line")
}

model BudgetLineMonth {
  id               Int        @id @default(autoincrement())
  lineId           Int        @map("line_id")
  month            Month
  amount           Decimal    @default(0) @db.Decimal(18, 4)
  calculatedAmount Decimal?   @map("calculated_amount") @db.Decimal(18, 4)
  isOverride       Boolean    @default(false) @map("is_override")
  overrideReason   String?    @map("override_reason") @db.VarChar(255)
  calculatedAt     DateTime?  @map("calculated_at") @db.Timestamptz(6)
  /// Que opcion se eligio para el mes: "predicted" | "lower" | "upper"
  /// (bandas del modelo), "y2025" (cierre de ese año) o "manual" (capturado
  /// a mano). Null en lo capturado antes de que existiera la columna.
  variant          String?    @db.VarChar(20)
  line             BudgetLine @relation(fields: [lineId], references: [id], onDelete: Restrict)

  @@unique([lineId, month])
  @@index([month])
  @@map("budget_line_month")
}

model BudgetLineLink {
  id           Int        @id @default(autoincrement())
  targetLineId Int        @map("target_line_id")
  sourceLineId Int        @map("source_line_id")
  ratio        Decimal    @default(1) @db.Decimal(9, 6)
  description  String?    @db.VarChar(255)
  targetLine   BudgetLine @relation("partida_enlace_partida_destino_id", fields: [targetLineId], references: [id], onDelete: Restrict)
  sourceLine   BudgetLine @relation("partida_enlace_partida_origen_id", fields: [sourceLineId], references: [id], onDelete: Restrict)

  @@unique([targetLineId, sourceLineId])
  @@map("budget_line_link")
}

model MonthlyRevenue {
