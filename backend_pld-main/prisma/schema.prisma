  accessGrantBusinessUnit AccessGrantBusinessUnit[]
  accessGrantCostCenter   AccessGrantCostCenter[]

  @@unique([userId, roleId, fiscalYearId], map: "ux_grant_vigente")
  @@index([userId])
  @@map("access_grant")
}

model AccessGrantDepartment {
  grantId      Int         @map("grant_id")
  departmentId Int         @map("department_id")
  grant        AccessGrant @relation(fields: [grantId], references: [id], onDelete: Restrict)
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([grantId, departmentId])
  @@map("access_grant_department")
}

model AccessGrantBusinessUnit {
  grantId        Int          @map("grant_id")
  businessUnitId Int          @map("business_unit_id")
  grant          AccessGrant  @relation(fields: [grantId], references: [id], onDelete: Restrict)
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)

  @@id([grantId, businessUnitId])
  @@map("access_grant_business_unit")
}

model AccessGrantCostCenter {
  grantId      Int         @map("grant_id")
  costCenterId Int         @map("cost_center_id")
  grant        AccessGrant @relation(fields: [grantId], references: [id], onDelete: Restrict)
  costCenter   CostCenter  @relation(fields: [costCenterId], references: [id], onDelete: Restrict)

  @@id([grantId, costCenterId])
  @@map("access_grant_cost_center")
}

model UserContext {
  userId         Int          @id @map("user_id")
  businessUnitId Int          @map("business_unit_id")
  fiscalYearId   Int          @map("fiscal_year_id")
  costCenterId   Int?         @map("cost_center_id")
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  fiscalYear     FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  costCenter     CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: Restrict)

  @@map("user_context")
}

model AccessLog {
  id             BigInt        @id @default(autoincrement())
  userId         Int           @map("user_id")
  result         AccessResult
  object         String        @db.VarChar(80)
  businessUnitId Int?          @map("business_unit_id")
  departmentId   Int?          @map("department_id")
  ip             String?       @db.Inet
  userAgent      String?       @map("user_agent") @db.VarChar(255)
  loggedAt       DateTime      @default(now()) @map("logged_at") @db.Timestamptz(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([userId, loggedAt])
  @@index([result, loggedAt], map: "ix_log_access_denegados")
  @@map("access_log")
}

model SystemObject {
  id               Int              @id @default(autoincrement())
  code             String           @unique @db.VarChar(80)
  name             String           @db.VarChar(150)
  type             SystemObjectType @default(table)
  module           String           @db.VarChar(40)
  departmentId     Int?             @map("department_id")
  departmentPath   String?          @map("department_path") @db.VarChar(255)
  businessUnitPath String?          @map("business_unit_path") @db.VarChar(255)
  commentable      Boolean          @default(true)
  auditReads       Boolean          @default(false) @map("audit_reads")
  sensitive        Boolean          @default(false)
  active           Boolean          @default(true)
  department       Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  commentThread    CommentThread[]
  permission       Permission[]
  setting          Setting[]

  @@map("system_object")
}

model Permission {
  id                    Int                     @id @default(autoincrement())
  systemObjectId        Int                     @map("system_object_id")
  action                Action
  field                 String?                 @db.VarChar(60)
  code                  String                  @unique @db.VarChar(120)
  description           String?                 @db.VarChar(255)
  object                SystemObject            @relation(fields: [systemObjectId], references: [id], onDelete: Restrict)
  rolePermission        RolePermission[]
  accessGrantPermission AccessGrantPermission[]

  @@unique([systemObjectId, action, field])
  @@map("permission")
}

model RolePermission {
  roleId       Int              @map("role_id")
  permissionId Int              @map("permission_id")
  effect       PermissionEffect @default(allow)
  role         Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model AccessGrantPermission {
  grantId      Int              @map("grant_id")
  permissionId Int              @map("permission_id")
  effect       PermissionEffect
  reason       String?          @db.VarChar(255)
  grant        AccessGrant      @relation(fields: [grantId], references: [id], onDelete: Restrict)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([grantId, permissionId])
  @@map("access_grant_permission")
}

model Setting {
  id               Int           @id @default(autoincrement())
  systemObjectId   Int?          @map("system_object_id")
  code             String        @db.VarChar(80)
  name             String        @db.VarChar(180)
  area             SettingScope  @default(global)
  dataType         String        @default("numeric") @map("data_type") @db.VarChar(20)
  value            String
  unit             String?       @db.VarChar(20)
  fiscalYearId     Int?          @map("fiscal_year_id")
  businessUnitId   Int?          @map("business_unit_id")
  departmentId     Int?          @map("department_id")
  costCenterId     Int?          @map("cost_center_id")
  userId           Int?          @map("user_id")
  editableByRoleId Int?          @map("editable_by_role_id")
  validFrom        DateTime?     @map("valid_from") @db.Date
  validUntil       DateTime?     @map("valid_until") @db.Date
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  object           SystemObject? @relation(fields: [systemObjectId], references: [id], onDelete: Restrict)
  fiscalYear       FiscalYear?   @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  businessUnit     BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  department       Department?   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  costCenter       CostCenter?   @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  user             User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  editableByRole   Role?         @relation(fields: [editableByRoleId], references: [id], onDelete: Restrict)

  @@unique([code, area, fiscalYearId, businessUnitId, departmentId], map: "ux_setting_per_scope")
  @@map("setting")
}

model AuthUser {
  id            String   @id @db.VarChar(64)
  name          String   @db.VarChar(255)
  email         String   @unique @db.VarChar(255)
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  // Columnas del plugin admin. `role` es de Better Auth ("user" / "admin") y no
  // tiene relacion con el modelo Role del negocio: los permisos salen de AccessGrant.
  role       String?   @db.VarChar(40)
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires") @db.Timestamptz(6)

  // Columna del plugin twoFactor
  twoFactorEnabled Boolean? @default(false) @map("two_factor_enabled")

  user        User?
  authSession AuthSession[]
  authAccount AuthAccount[]
  twoFactor   TwoFactor[]

  @@map("auth_user")
}

model AuthSession {
  id             String   @id @db.VarChar(64)
  userId         String   @map("user_id") @db.VarChar(64)
  token          String   @unique @db.VarChar(255)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// Plugin admin: quien esta suplantando a este usuario, si aplica.
  impersonatedBy String?  @map("impersonated_by") @db.VarChar(64)
  user           AuthUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("auth_session")
}

model AuthAccount {
  id                    String    @id @db.VarChar(64)
  userId                String    @map("user_id") @db.VarChar(64)
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(64)
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  idToken               String?   @map("id_token")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_account")
}

/// Segundo factor por usuario. La administra el plugin twoFactor de Better Auth.
model TwoFactor {
  id                      String   @id
  userId                  String   @map("user_id") @db.VarChar(64)
  secret                  String
  backupCodes             String   @map("backup_codes")
  verified                Boolean? @default(true)
  failedVerificationCount Int?     @default(0) @map("failed_verification_count")
  user                    AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor")
}

model AuthVerification {
  id         String   @id @db.VarChar(64)
  identifier String   @db.VarChar(255)
  value      String   @db.VarChar(255)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("auth_verification")
}

enum MetricType {
  base
  nested

  @@map("metric_type")
}

model MetricResource {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  code                String                @unique @db.VarChar(60)
  name                String                @db.VarChar(180)
  type                MetricType
  scope               Json                  @db.JsonB
  expression          String?
  /// Como se aplica/calcula este recurso -- texto libre, se llena a futuro. No es identidad, solo documentacion.
  howApplied          String?               @map("how_applied") @db.VarChar(255)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy           Int                   @map("created_by")
  businessUnitId      Int                   @map("business_unit_id")
  createdBy2          User                  @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  businessUnit        BusinessUnit          @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  metricResourceValue MetricResourceValue[]
  dependsOn           MetricDependency[]    @relation("MetricDependencies")
  dependents          MetricDependency[]    @relation("MetricDependents")

  @@map("metric_resource")
}

model MetricResourceValue {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  metricId       String         @map("metric_id") @db.VarChar(36)
  fiscalYearId   Int            @map("fiscal_year_id")
  /// NULL = valor global (aplica a todo el scope del recurso). No nulo = el valor de ESE casino/departamento especificamente.
  businessUnitId Int?           @map("business_unit_id")
  departmentId   Int?           @map("department_id")
  value          Decimal        @db.Decimal(18, 6)
  isProjection   Boolean        @default(false) @map("is_projection")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy      Int            @map("created_by")
  metric         MetricResource @relation(fields: [metricId], references: [id], onDelete: Restrict)
  fiscalYear     FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  businessUnit   BusinessUnit?  @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy2     User           @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([metricId, fiscalYearId, businessUnitId, departmentId])
  @@map("metric_resource_value")
}

model MetricDependency {
  metricId          String         @map("metric_id") @db.VarChar(36)
  dependsOnMetricId String         @map("depends_on_metric_id") @db.VarChar(36)
  metric            MetricResource @relation("MetricDependencies", fields: [metricId], references: [id], onDelete: Cascade)
  dependsOnMetric   MetricResource @relation("MetricDependents", fields: [dependsOnMetricId], references: [id], onDelete: Cascade)

  @@id([metricId, dependsOnMetricId])
  @@map("metric_dependency")
}

model MetricResourceSnapshot {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  finalBudgetId Int      @map("final_budget_id")
  metricValues  Json     @map("metric_values") @db.JsonB
  specifiedDate DateTime @map("specified_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy     Int      @map("created_by")
  budget        Budget   @relation(fields: [finalBudgetId], references: [id], onDelete: Restrict)
  createdBy2    User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("metric_resource_snapshot")
}

model MetricDefinition {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  name           String               @db.VarChar(150)
  description    String?
  unit           MetricUnit
  granularity    MetricGranularity
  type           MetricDefinitionType
  date           DateTime             @db.Date
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  metricForecast MetricForecast[]
  metricTraining MetricTraining[]

  @@map("metric_definition")
}

model MetricTraining {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  metricCode     String           @map("metric_code") @db.VarChar(36)
  businessUnitId Int              @map("business_unit_id")
  date           DateTime         @db.Date
  value          Decimal          @db.Decimal(18, 6)
  department     Int?
  account        String?          @db.VarChar(80)
  subaccount     String?          @db.VarChar(80)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  metricCode2    MetricDefinition @relation(fields: [metricCode], references: [id], onDelete: Restrict)
  businessUnit   BusinessUnit     @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  department2    Department?      @relation(fields: [department], references: [id], onDelete: Restrict)

  @@index([businessUnitId, date])
  @@map("metric_training")
}

model MetricForecast {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  metricCode      String           @map("metric_code") @db.VarChar(36)
  businessUnitId  Int              @map("business_unit_id")
  date            DateTime         @db.Date
  predictedValue  Decimal          @map("predicted_value") @db.Decimal(18, 6)
  lowerBound      Decimal?         @map("lower_bound") @db.Decimal(18, 6)
  upperBound      Decimal?         @map("upper_bound") @db.Decimal(18, 6)
  confidenceLevel Decimal?         @map("confidence_level") @db.Decimal(5, 4)
  model           String?          @db.VarChar(60)
  modelVersion    String?          @map("model_version") @db.VarChar(40)
  generatedAt     DateTime         @default(now()) @map("generated_at") @db.Timestamptz(6)
  department      Int?
  account         String?          @db.VarChar(80)
  subaccount      String?          @db.VarChar(80)
  metricCode2     MetricDefinition @relation(fields: [metricCode], references: [id], onDelete: Restrict)
  businessUnit    BusinessUnit     @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  department2     Department?      @relation(fields: [department], references: [id], onDelete: Restrict)

  @@index([businessUnitId, date])
  @@map("metric_forecast")
}

/// Lo presupuestado de una metrica de ingresos (Ingresos Maquinas, DAU...)
/// por casino y mes, en el ejercicio que se presupuesta. Es la hoja de
/// Ingresos y metas: cada mes guarda que opcion del modelo se eligio
/// ("predicted" | "lower" | "upper", "y2025" para el cierre de ese año) o
/// "manual" cuando se capturo a mano, igual que budget_line_month.
model MetricBudgetMonth {
  id             Int          @id @default(autoincrement())
  fiscalYearId   Int          @map("fiscal_year_id")
  businessUnitId Int          @map("business_unit_id")
  /// Nombre de la metrica (metric_definition.name): la de pronostico y la de
  /// entrenamiento comparten nombre y no id.
  metric         String       @db.VarChar(150)
  month          Month
  amount         Decimal      @default(0) @db.Decimal(18, 4)
  variant        String?      @db.VarChar(20)
  isOverride     Boolean      @default(false) @map("is_override")
  overrideReason String?      @map("override_reason") @db.VarChar(255)
  updatedBy      Int?         @map("updated_by")
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  fiscalYear     FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)

  @@unique([fiscalYearId, businessUnitId, metric, month])
  @@index([fiscalYearId, metric])
  @@map("metric_budget_month")
}
