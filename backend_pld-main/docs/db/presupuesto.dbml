// =============================================================================
// AGRUPACIONES PARA EL DIAGRAMA
// =============================================================================

// Estructura organizacional y parametros
TableGroup catalogos {
  empresa
  unidad_negocio
  centro_costo
  departamento
  usuario
  ejercicio
  calendario_mes
}

// Definicion de las hojas del libro
TableGroup estructura_cedulas {
  cedula
  cedula_nota
  categoria
  concepto
}

// Cabecera, renglones y valores mensuales
TableGroup nucleo {
  presupuesto
  presupuesto_partida
  partida_mes
  partida_enlace
}

// Catalogo de precios, parametros y tabuladores
TableGroup recursos {
  recurso
  recurso_valor
  recurso_cantidad
  recurso_factor
  demanda_mes
  recurso_recalculo
  cuenta_contable
}

// Captura colaborativa y ciclo de revision
TableGroup colaboracion {
  partida_asignacion
  conversacion
  mensaje
  adjunto
  avance_captura
  envio_revision
  dictamen
}

// Nomina y Gente y Cultura
TableGroup rh {
  nomina_prestacion
  evento_integracion
}

// Ingresos, licencias, regalias y viaticos
TableGroup operacion {
  ingreso_mes
  licencia
  licencia_partida
  regalia_maquina
  regalia_mesa
  viaje_presupuestado
}

// MP AyB: insumos
TableGroup materia_prima {
  mp_insumo_bloque
  mp_insumo_bloque_mes
  mp_resumen_mes
}

// Referencia del anio anterior
TableGroup historicos {
  historico_mensual_udn
  historico_insumo
}

// TPV, activos e impuestos
TableGroup financiero_fiscal {
  proveedor_tpv
  tasa_tpv
  comision_tpv_partida
  activo_fijo
  depreciacion_mes
  base_fiscal_mes
  tipo_impuesto
  impuesto_mes
  participacion_mes
}

// Seguimiento presupuestal
TableGroup control {
  ejercido_mes
  bitacora_presupuesto
}

// Metricas de negocio y salida del modelo
TableGroup metricas {
  metric_definition
  metric_forecast
}

// Better Auth: quien eres
TableGroup autenticacion {
  auth_user
  auth_session
  auth_account
  auth_verification
}

// Acceso por departamento x casino: que puedes tocar
TableGroup seguridad {
  rol
  objeto_sistema
  permiso
  rol_permiso
  asignacion_permiso
  regla
  variable
  asignacion
  asignacion_departamento
  asignacion_unidad
  asignacion_centro_costo
  usuario_contexto
  bitacora_acceso
}

